# ============================================================
# テスト環境用 環境変数テンプレート
# ============================================================
# 使い方：
# 1. Supabaseダッシュボードでテスト用プロジェクトを作成
# 2. このファイルをコピーして .env.local という名前で保存
# 3. 下記の値をテストプロジェクトのものに書き換える
#    （Project Settings → API から確認できます）
# ============================================================

# テスト用 Supabase プロジェクトの URL
NEXT_PUBLIC_SUPABASE_URL=https://【テストプロジェクトID】.supabase.co

# テスト用 Supabase 匿名キー（anon key）
NEXT_PUBLIC_SUPABASE_ANON_KEY=【テスト用 anon key をここに貼る】

# テスト用 Supabase サービスロールキー（service_role key）
SUPABASE_SERVICE_ROLE_KEY=【テスト用 service_role key をここに貼る】

# アプリURL（開発時はそのまま）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# cronジョブ用シークレット（テスト用なので任意の文字列でOK）
CRON_SECRET=mominoki-test-2024
